<Window x:Class="MisterVpnClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mister VPN"
        Height="760"
        Width="1120"
        MinHeight="720"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">
    <Window.Resources>
        <SolidColorBrush x:Key="Black" Color="#000000"/>
        <SolidColorBrush x:Key="Surface" Color="#111111"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="Border" Color="#222222"/>
        <SolidColorBrush x:Key="BorderVisible" Color="#333333"/>
        <SolidColorBrush x:Key="TextDisabled" Color="#666666"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#999999"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="TextDisplay" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#FF3830"/>
        <SolidColorBrush x:Key="Success" Color="#4A9E5C"/>

        <DrawingBrush x:Key="DotGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,14,14"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,14,14"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#333333">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1.5,1.5" RadiusX="0.65" RadiusY="0.65"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Space Mono, Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="DataText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Space Mono, Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextDisplay}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="DotoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Doto, Space Mono, Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextDisplay}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderVisible}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SmallCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Space Mono, Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderVisible}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=6}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TextPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisplay}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextDisplay}"/>
            <Setter Property="Background" Value="#080808"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderVisible}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Space Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Space Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderVisible}" BorderThickness="1" Background="{StaticResource Black}">
        <Grid MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="96"/>
                <RowDefinition/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" Opacity="0.18" Background="{StaticResource DotGridBrush}"/>

            <Grid Grid.Row="0" Margin="24,16,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MISTER:VPN"
                                   Style="{StaticResource DotoText}"
                                   FontSize="34"/>
                        <Border Width="8" Height="8" Margin="18,4,0,0"
                                Background="{StaticResource Accent}"
                                CornerRadius="4"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel Margin="0,2,28,0">
                            <TextBlock Text="SECURE TUNNEL" Style="{StaticResource LabelText}"/>
                            <TextBlock Text="DESKTOP CLIENT" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="_" Width="34" Height="28" Padding="0" BorderBrush="Transparent" Click="MinimizeButton_Click"/>
                        <Button Content="[]" Width="34" Height="28" Padding="0" BorderBrush="Transparent" Click="MaximizeButton_Click"/>
                        <Button Content="X" Width="34" Height="28" Padding="0" BorderBrush="Transparent" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource BorderVisible}"/>

                <Grid Grid.Row="2">
                    <TextBlock Text="A NOTHING-INSPIRED CONTROL SURFACE FOR A FAST PRIVATE CONNECTION"
                               Style="{StaticResource LabelText}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="v0.1.0"
                               Style="{StaticResource LabelText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="24,18,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="1.15*"/>
                        <RowDefinition Height="0.85*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Rows="2" Columns="4">
                        <Button Content="#  OVERVIEW" Height="38" Margin="0,0,5,5" BorderBrush="{StaticResource TextPrimary}" Foreground="{StaticResource TextDisplay}"/>
                        <Button Content="SERVER" Height="38" Margin="0,0,5,5"/>
                        <Button Content="ROUTES" Height="38" Margin="0,0,5,5"/>
                        <Button Content="SYSTEM" Height="38" Margin="0,0,0,5"/>
                        <Button Content="TRAFFIC" Height="38" Margin="0,0,5,0"/>
                        <Button Content="PROXY" Height="38" Margin="0,0,5,0"/>
                        <Button Content="LOGS" Height="38" Margin="0,0,5,0" Click="TogglePanelButton_Click"/>
                        <Button Content="CONFIG" Height="38" Click="TogglePanelButton_Click"/>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="136"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VPN STATUS" Style="{StaticResource LabelText}"/>
                                <TextBlock x:Name="StatusText"
                                           Text="OFFLINE"
                                           Style="{StaticResource DotoText}"
                                           FontSize="58"
                                           Margin="0,18,0,0"/>
                                <TextBlock Text="WIREGUARD / XRAY CONTROL"
                                           Style="{StaticResource LabelText}"
                                           Margin="0,12,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                                    <Border Background="{StaticResource Accent}" Width="9" Height="9" CornerRadius="4.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="ONE TAP CONNECT"
                                               Style="{StaticResource LabelText}"
                                               Foreground="{StaticResource TextPrimary}"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Ellipse Stroke="{StaticResource BorderVisible}" StrokeThickness="1"/>
                                <Ellipse Stroke="{StaticResource Border}" StrokeThickness="1" Margin="16"/>
                                <Ellipse Stroke="{StaticResource TextDisabled}" StrokeThickness="1" Margin="32"/>
                                <Button x:Name="PowerButton"
                                        Width="82"
                                        Height="82"
                                        Tag="41"
                                        Background="#050505"
                                        BorderBrush="{StaticResource TextPrimary}"
                                        Click="PowerButton_Click"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PowerIcon"
                                               Text="I/O"
                                               Style="{StaticResource DotoText}"
                                               FontSize="22"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SmallCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="SERVER" Style="{StaticResource LabelText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Grid Width="20" Height="20">
                                        <Ellipse Stroke="{StaticResource TextPrimary}" StrokeThickness="1" Fill="#050505"/>
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="ServerText"
                                               Text="GERMANY"
                                               Style="{StaticResource DataText}"
                                               FontSize="22"
                                               Margin="12,-3,0,0"/>
                                </StackPanel>
                                <TextBlock Text="AUTO SELECTED" Style="{StaticResource LabelText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SmallCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="LATENCY" Style="{StaticResource LabelText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock x:Name="PingText" Text="--" Style="{StaticResource DotoText}" FontSize="34"/>
                                    <TextBlock Text="MS" Style="{StaticResource LabelText}" Margin="8,18,0,0"/>
                                </StackPanel>
                                <Grid Height="10" Margin="0,16,0,0">
                                    <UniformGrid Columns="12">
                                        <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                        <Rectangle Fill="{StaticResource BorderVisible}"/>
                                    </UniformGrid>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Column="1" Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1.05*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TUNNEL MODE" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="5G SAFE" Style="{StaticResource DotoText}" FontSize="44" Margin="0,14,0,0"/>
                                <TextBlock Text="SMART PROXY ENABLED" Style="{StaticResource LabelText}" Margin="0,10,0,0"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Ellipse Stroke="{StaticResource BorderVisible}" StrokeThickness="1" Margin="10"/>
                                <Ellipse Stroke="{StaticResource TextDisabled}" StrokeThickness="1" Margin="28"/>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SmallCard}" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="DOWNLOAD" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="128" Style="{StaticResource DotoText}" FontSize="40" Margin="0,14,0,0"/>
                                <TextBlock Text="MB / SESSION" Style="{StaticResource LabelText}"/>
                                <UniformGrid Columns="14" Height="9" Margin="0,16,0,0">
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SmallCard}" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="UPLOAD" Style="{StaticResource LabelText}"/>
                                <TextBlock Text="42" Style="{StaticResource DotoText}" FontSize="40" Margin="0,14,0,0"/>
                                <TextBlock Text="MB / SESSION" Style="{StaticResource LabelText}"/>
                                <UniformGrid Columns="14" Height="9" Margin="0,16,0,0">
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource TextDisplay}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}" Margin="0,0,3,0"/>
                                    <Rectangle Fill="{StaticResource BorderVisible}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CONNECTION DETAILS" Style="{StaticResource LabelText}"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="#" Grid.Row="0" Style="{StaticResource DataText}" FontSize="22"/>
                                <TextBlock Text="DEVICE CODE" Grid.Row="0" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="MVPN-02" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Text="&lt;&gt;" Grid.Row="1" Style="{StaticResource DataText}" FontSize="18"/>
                                <TextBlock Text="PROTOCOL" Grid.Row="1" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="VLESS / XRAY" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Text="[]" Grid.Row="2" Style="{StaticResource DataText}" FontSize="18"/>
                                <TextBlock Text="SYSTEM PROXY" Grid.Row="2" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="WINDOWS" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Text="i" Grid.Row="3" Style="{StaticResource DataText}" FontSize="22"/>
                                <TextBlock Text="UPTIME" Grid.Row="3" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="00H 00M 00S" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1.08*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="SYSTEM ACTIVITY" Style="{StaticResource LabelText}"/>
                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="72"/>
                                </Grid.RowDefinitions>
                                <Canvas Margin="0,0,0,10">
                                    <Polyline Stroke="{StaticResource TextDisplay}" StrokeThickness="1.6"
                                              Points="0,112 18,84 36,92 54,70 72,96 90,58 108,72 126,44 144,64 162,52 180,36 198,58 216,42 234,66 252,40 270,52 288,28 306,44"/>
                                    <Line X1="0" Y1="118" X2="310" Y2="118" Stroke="{StaticResource BorderVisible}" StrokeThickness="1"/>
                                    <Line X1="0" Y1="64" X2="310" Y2="64" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="2,5"/>
                                    <Ellipse Canvas.Left="302" Canvas.Top="40" Width="8" Height="8" Fill="{StaticResource Accent}"/>
                                </Canvas>
                                <UniformGrid Grid.Row="1" Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="LOAD" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="68%" Style="{StaticResource DotoText}" FontSize="28"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="PACKETS" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="8.3K" Style="{StaticResource DotoText}" FontSize="28"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="STATE" Style="{StaticResource LabelText}"/>
                                        <TextBlock Text="SAFE" Foreground="{StaticResource Success}" FontFamily="Space Mono, Consolas" FontSize="22"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="SubscriptionPanel"
                            Grid.Row="1"
                            Style="{StaticResource Card}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="108"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="42"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="CONFIG / LOG" Style="{StaticResource LabelText}"/>
                            <TextBox x:Name="SubscriptionBox"
                                     Grid.Row="1"
                                     Margin="0,10,0,0"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                            <CheckBox x:Name="SystemProxyCheckBox"
                                      Grid.Row="2"
                                      Content="ENABLE WINDOWS SYSTEM PROXY"
                                      IsChecked="True"
                                      Margin="0,10,0,0"/>
                            <Button Grid.Row="3"
                                    Content="SAVE CONFIG"
                                    Height="34"
                                    Margin="0,8,0,0"
                                    BorderBrush="{StaticResource TextPrimary}"
                                    Click="SaveButton_Click"/>
                            <TextBox x:Name="LogBox"
                                     Grid.Row="4"
                                     Margin="0,12,0,0"
                                     Background="#050505"
                                     BorderBrush="{StaticResource BorderVisible}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>

                    <Border x:Name="QuickControlsPanel"
                            Grid.Row="1"
                            Style="{StaticResource Card}"
                            Visibility="Visible">
                        <StackPanel>
                            <TextBlock Text="QUICK CONTROLS" Style="{StaticResource LabelText}"/>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Content="CONFIG" Height="54" Margin="0,0,8,0" Click="TogglePanelButton_Click"/>
                                <Button Grid.Column="1" Content="ROUTES" Height="54" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="LOGS" Height="54" Click="TogglePanelButton_Click"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Border}" Margin="0,22,0,18"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="112"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="01" Grid.Row="0" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="PROFILE" Grid.Row="0" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="GERMANY" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Text="02" Grid.Row="1" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="KILL SWITCH" Grid.Row="1" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="READY" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource Success}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Text="03" Grid.Row="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="DNS MODE" Grid.Row="2" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="PRIVATE" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <TextBlock Text="04" Grid.Row="3" Style="{StaticResource LabelText}" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="SPLIT ROUTES" Grid.Row="3" Grid.Column="1" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                                <TextBlock Text="OFF" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelText}" Foreground="{StaticResource TextDisabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

